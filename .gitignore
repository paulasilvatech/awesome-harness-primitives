__pycache__/
*.py[cod]
.mypy_cache/
.venv/

# macOS metadata is local-only.
.DS_Store

# Local audit scratch output belongs under docs/audits/ only when intentionally retained.
.audit-work/
.linkwork-skills.json

# Large Microsoft security reference PDFs remain local and outside Git LFS.
docs/microsoft-security/**/*.pdf

# Hook runtime logs should live in Copilot/XDG state, not the repo.
logs/
.github/logs/

# Playwright MCP run artifacts are session output, not plugin components.
.playwright-mcp/

# .NET build output bakes in absolute paths and is never skill content.
obj/Debug/
obj/Release/
bin/Debug/
bin/Release/
