{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LICENSE_MODE=warn \"${CLAUDE_PROJECT_DIR}/.claude/hooks/dependency-license-checker/check-licenses.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/governance-audit/audit-session-end.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCAN_MODE=warn SCAN_SCOPE=diff \"${CLAUDE_PROJECT_DIR}/.claude/hooks/secrets-scanner/scan-secrets.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-logger/log-session-end.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/governance-audit/audit-session-start.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-logger/log-session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "BLOCK_ON_THREAT=false GOVERNANCE_LEVEL=standard \"${CLAUDE_PROJECT_DIR}/.claude/hooks/governance-audit/audit-prompt.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "LOG_LEVEL=INFO \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-logger/log-prompt.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
