  "version": "1.0.3",
  "author": {
    "name": "James Montemagno",
    "url": "https://github.com/jamesmontemagno"
  },
  "keywords": [
    "cross-repo-dashboard",
    "focus-planning",
    "repo-health",
    "session-cleanup",
    "work-triage",
    "workflow-visibility"
