{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "open-horizons-platform",
  "description": "Open Horizons agentic DevOps platform toolkit for Azure, AKS, Backstage, GitHub, Azure DevOps, Terraform, security, reliability, architecture, and deployment operations. Use it to install the platform's specialist agents, reusable skills, and MCP integrations as one GitHub Copilot plugin.",
  "version": "1.0.0",
  "author": {
    "name": "Open Horizons Contributors",
    "url": "https://github.com/Ohorizons"
  },
  "repository": "https://github.com/paulasilvatech/copilot-primitives",
  "homepage": "https://github.com/Ohorizons/open-horizons-platform",
  "license": "MIT",
  "keywords": [
    "open-horizons",
    "azure",
    "aks",
    "backstage",
    "terraform",
    "devops",
    "platform-engineering",
    "agentic-devops",
    "copilot-cli",
    "github-copilot"
  ],
  "extensions": {
    "com.github.copilot": {
      "agents": [
        "./agents/ado-integration.agent.md",
        "./agents/azure-portal-deploy.agent.md",
        "./agents/backstage-expert.agent.md",
        "./agents/deploy.agent.md",
        "./agents/github-integration.agent.md",
        "./agents/hybrid-scenarios.agent.md",
        "./agents/security.agent.md",
        "./agents/sre.agent.md",
        "./agents/terraform.agent.md"
      ],
      "skills": [
        "./skills/agentic-architecture-patterns/",
        "./skills/ai-foundry-operations/",
        "./skills/architecture-doc/",
        "./skills/argocd-cli/",
        "./skills/azure-architecture-diagrams/",
        "./skills/azure-cli/",
        "./skills/azure-infrastructure/",
        "./skills/azure-managed-redis-cache/",
        "./skills/backstage-deployment/",
        "./skills/backstage-plugin-builder/",
        "./skills/codespaces-golden-paths/",
        "./skills/database-management/",
        "./skills/deploy-orchestration/",
        "./skills/foundry-agent-blueprint/",
        "./skills/github-cli/",
        "./skills/helm-cli/",
        "./skills/issue-ops/",
        "./skills/kubectl-cli/",
        "./skills/markdown-writer/",
        "./skills/mcp-ecosystem/",
        "./skills/observability-stack/",
        "./skills/pipeline-diagnostics/",
        "./skills/prerequisites/",
        "./skills/requirements-engineer/",
        "./skills/sdd-spec-engineer/",
        "./skills/story-planning/",
        "./skills/terraform-cli/",
        "./skills/test-coverage/",
        "./skills/validation-scripts/"
      ],
      "mcpServers": "./mcp.json"
    },
    "com.paulasilvatech.copilot-primitives": {
      "componentSource": "plugin"
    }
  },
  "agents": [
    "./agents/ado-integration.agent.md",
    "./agents/azure-portal-deploy.agent.md",
    "./agents/backstage-expert.agent.md",
    "./agents/deploy.agent.md",
    "./agents/github-integration.agent.md",
    "./agents/hybrid-scenarios.agent.md",
    "./agents/security.agent.md",
    "./agents/sre.agent.md",
    "./agents/terraform.agent.md"
  ],
  "skills": [
    "./skills/agentic-architecture-patterns/",
    "./skills/ai-foundry-operations/",
    "./skills/architecture-doc/",
    "./skills/argocd-cli/",
    "./skills/azure-architecture-diagrams/",
    "./skills/azure-cli/",
    "./skills/azure-infrastructure/",
    "./skills/azure-managed-redis-cache/",
    "./skills/backstage-deployment/",
    "./skills/backstage-plugin-builder/",
    "./skills/codespaces-golden-paths/",
    "./skills/database-management/",
    "./skills/deploy-orchestration/",
    "./skills/foundry-agent-blueprint/",
    "./skills/github-cli/",
    "./skills/helm-cli/",
    "./skills/issue-ops/",
    "./skills/kubectl-cli/",
    "./skills/markdown-writer/",
    "./skills/mcp-ecosystem/",
    "./skills/observability-stack/",
    "./skills/pipeline-diagnostics/",
    "./skills/prerequisites/",
    "./skills/requirements-engineer/",
    "./skills/sdd-spec-engineer/",
    "./skills/story-planning/",
    "./skills/terraform-cli/",
    "./skills/test-coverage/",
    "./skills/validation-scripts/"
  ],
  "mcpServers": "./mcp.json",
  "postInstallMessage": "Open Horizons agents, skills, and MCP integrations are installed. Repository-scoped instructions, prompts, issue forms, workflows, and templates remain available in the plugin package as an optional .github workspace kit; publish only the assets required by the target repository."
}
